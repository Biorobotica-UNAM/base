<launch>

  <arg name="joint_name" default="virtual_joint"/>
  <arg name="odom_topic" default="odom"/>
  <arg name="output_topic" default="joint_states"/>

  <group>
    <push-ros-namespace namespace="base"/>

    <node pkg="base"
          exec="virtual_joint_publisher_node"
          name="virtual_joint_publisher_node"
          output="screen">
      <param name="joint_name"   value="$(var joint_name)"/>
      <param name="odom_topic"   value="$(var odom_topic)"/>
      <param name="output_topic" value="$(var output_topic)"/>
    </node>

  </group>

</launch>
