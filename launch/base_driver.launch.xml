<?xml version="1.0"?>
<launch>

  <!-- ===== Launch arguments ===== -->
  <arg name="namespace"    default="base"  description="Top-level namespace" />
  <arg name="tf_prefix"    default=""      description="TF prefix (include trailing slash if non-empty, e.g. 'hardware/')" />

  <arg name="use_sim_time" default="false" description="Use simulation clock if true" />

  <arg name="launch_jsb"
       default="false"
       description="Whether to start the joint state broadcaster or not" />

  <!-- Path to robot URDF or XACRO file -->
  <arg name="robot_description"
       default="$(find-pkg-share justina_description)/urdf/justina.urdf"
       description="Full path to robot description (.urdf or .urdf.xacro)" />

  <arg name="hostname"
       default="127.0.1.1"
       description="IP address of robotino" />

  <arg name="rsp_freq"
       default="20.0"
       description="Publish frequency for robot_state_publisher" />

  <arg name="bumper_timeout"
       default="2.0"
       description="Time to stop robot when bumper is hit" />

  <arg name="motor_timeout"
       default="0.0"
       description="Time to stop robot when motor is not responding" />

  <arg name="launch_odom_tf"
       default="true"
       description="Whether to broadcast the odom TF" />

  <!-- ===== Group with namespace 'base' ===== -->
  <group>
    <push-ros-namespace namespace="base"/>

    <!-- Robotino base driver -->
    <node pkg="base" exec="base" name="base_node">
      <param name="hostname"        value="$(var hostname)" />
      <param name="tf_prefix"       value="$(var tf_prefix)" />
      <param name="bumper_timeout"  value="$(var bumper_timeout)" />
      <param name="motor_timeout"   value="$(var motor_timeout)" />
    </node>

    <!-- Odometry node -->
    <node pkg="base" exec="robotino_odometry_node" name="robotino_odometry_node">
      <param name="hostname"         value="$(var hostname)" />
      <param name="tf_prefix"        value="$(var tf_prefix)" />
      <param name="publish_odom_tf"  value="$(var launch_odom_tf)" />
    </node>

    <!-- Joint State Publisher (condicional) -->
    <node pkg="joint_state_publisher"
          exec="joint_state_publisher"
          name="joint_state_publisher"
          if="$(var launch_jsb)">
    </node>

    <!-- URG LIDAR -->
    <node pkg="urg_node"
          exec="urg_node_driver"
          name="urg_node"
          output="log">
      <param name="serial_port"    value="/dev/lidar" />
      <param name="serial_baud"    value="115200" />
      <param name="frame_id"       value="laser_link" />
      <param name="calibrate_time" value="false" />
      <param name="laser_frame_id" value="laser_link" />
      <param name="angle_min"      value="-1.5708" />
      <param name="angle_max"      value="1.5708" />
    </node>

    <node 
        pkg="base" 
        exec="Stop_node" 
        name="Stop_node"
        output="screen">
    </node>

  </group>

</launch>
